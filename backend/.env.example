# Postgres connection string (asyncpg driver for SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/vision_mcp
# Session cookie signing key (generate: python -c "import secrets; print(secrets.token_urlsafe(48))")
APP_SECRET_KEY=
# Fernet key for Vision API key encryption at rest (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
VISION_ENCRYPTION_KEY=
# Google OAuth (leave empty to disable Google login)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Public URL used to build the OpenCode config snippet
PUBLIC_BASE_URL=http://localhost:8000
# Frontend origin allowed by CORS
CORS_ALLOWED_ORIGIN=http://localhost:5173

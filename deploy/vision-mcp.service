# systemd unit for the backend (Architecture §23: direct uvicorn, no Docker).
# Install: cp vision-mcp.service /etc/systemd/system/ && systemctl enable --now vision-mcp

[Unit]
Description=Vision MCP backend (FastAPI + MCP, single worker)
After=network.target postgresql.service

[Service]
Type=exec
User=vision
WorkingDirectory=/srv/vision-mcp/backend
EnvironmentFile=/srv/vision-mcp/backend/.env
# single worker: in-memory limiter state matches Decision #9
ExecStart=/srv/vision-mcp/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=3

# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/vision-mcp/backend

[Install]
WantedBy=multi-user.target
